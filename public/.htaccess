<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect to HTTPS (exclude localhost and 127.0.0.1)
    RewriteCond %{HTTP_HOST} ^(www\.)?goatbook.site$
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    <FilesMatch "\.php$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type"
    </FilesMatch>

    # Protect .htaccess file
    <Files ".htaccess">
        Require all denied
    </Files>

    # Restrict access to phpinfo.php (optional)
    <Files "phpinfo.php">
        Require all denied
    </Files>

    # Secure uploads directory (disable PHP execution)
    <FilesMatch "^uploads/.*\.php$">
        Require all denied
    </FilesMatch>

    # Prevent directory listing
    Options -Indexes

    # Set default index file
    DirectoryIndex index.php
</IfModule>