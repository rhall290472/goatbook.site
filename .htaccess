DirectoryIndex index.php


Options +FollowSymLinks -Indexes


<Files .htaccess>
order allow,deny
deny from all
</Files>

# Begin EnforceSSL goatbook.site
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www.)?goatbook.site$
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L]
</IfModule>
# End EnforceSSL

